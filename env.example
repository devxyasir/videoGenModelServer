# ─── Server ───────────────────────────────────────────────────────────────────
APP_ENV=production                   # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=1                        # Uvicorn workers (keep 1 per GPU node)
LOG_LEVEL=info

# ─── Security ─────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_USE_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440     # 24h
API_KEYS=key_abc123,key_def456       # comma-separated static API keys

# ─── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── Model ────────────────────────────────────────────────────────────────────
MODEL_REPO=Symphone/ltx-video-2b-v0.9-fp8
MODEL_VARIANT=fp8                    # fp8 | mixed
HF_TOKEN=                            # optional, leave blank if public
MODEL_CACHE_DIR=./model_cache
DEVICE=cuda                          # cuda | cpu
TORCH_DTYPE=bfloat16                 # bfloat16 | float16 | float32

# ─── Inference Defaults ───────────────────────────────────────────────────────
DEFAULT_HEIGHT=512
DEFAULT_WIDTH=768
DEFAULT_NUM_FRAMES=25
DEFAULT_FPS=8
DEFAULT_GUIDANCE_SCALE=3.0
DEFAULT_NUM_INFERENCE_STEPS=50
MAX_CONCURRENT_JOBS=2                # parallel GPU slots

# ─── Storage ──────────────────────────────────────────────────────────────────
OUTPUT_DIR=./storage/outputs
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=20
OUTPUT_TTL_HOURS=24                  # auto-clean videos older than N hours

# ─── Optional S3 Upload ───────────────────────────────────────────────────────
USE_S3=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_HOUR=100

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./ltx_jobs.db
